      "title": "African Youth Not Just Inheritors of Climate Crisis But Builders of Solutions: DPM Temesgen",
      "publisher": "ena",
      "identified_publisher": "Ethiopian News Agency",
      "source_domain": "ena.et",
      "url": "https://www.ena.et/web/eng/w/eng_7268484",
      "published_at": "2025-09-05T10:09:00+00:00",
      "updated_at": null,
      "language": "en",
      "original_language": "en",
      "detected_language": "en",
