      "title": "China vows all-out efforts to help quake-hit Myanmar",
      "publisher": "ecns",
      "identified_publisher": null,
      "source_domain": "ecns.cn",
      "url": "http://www.ecns.cn/news/politics/2025-04-01/detail-iheqevhn5353709.shtml",
