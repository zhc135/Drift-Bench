              "attribute": "communications_loss",
              "value": "许多地区",
              "unit": null
            }
          ],
          "annotation_note": null
        },
        {
          "fact_span_id": "A003_F005",
          "span_text": "联合国人道主义事务协调厅（OCHA）报告称，首都维拉港国际机场因航站楼及道路网络受损而出现运营延误，跑道仍可使用。机场继续对所有商业航班关闭。\n\n",
          "start_offset": 192,
          "end_offset": 265,
          "sentence_ids": [
            8,
            9
          ],
          "fact_types": [
            "infrastructure",
            "aid",
            "response"
          ],
          "importance": "important",
          "evidence_status": "attributed_claim",
          "structured_attributes": [
            {
              "attribute": "runway",
              "value": "可使用",
              "unit": null
            },
            {
              "attribute": "commercial_operations",
              "value": "关闭",
              "unit": null
            },
            {
              "attribute": "delays",
              "value": "航站楼和道路网络受损",
              "unit": null
            },
            {
              "attribute": "attribution",
              "value": "OCHA",
              "unit": null
            }
          ],
          "annotation_note": null
        },
        {
          "fact_span_id": "A003_F006",
          "span_text": "山体滑坡也阻碍了通往港口的通道，限制必需物资和人员运输。\n\n",
          "start_offset": 265,
          "end_offset": 295,
          "sentence_ids": [
            10
          ],
          "fact_types": [
            "infrastructure",
            "aid",
            "secondary_hazard",
            "cause"
          ],
          "importance": "important",
          "evidence_status": "explicitly_reported",
          "structured_attributes": [
            {
              "attribute": "seaport_access",
              "value": "受山体滑坡阻碍",
              "unit": null
            }
          ],
          "annotation_note": null
        },
        {
          "fact_span_id": "A003_F007",
          "span_text": "OCHA 表示，联合国及合作伙伴正在调动资源进行响应，并向地震灾区部署响应团队，其中包括联合国灾害评估与协调小组。\n\n",
          "start_offset": 295,
          "end_offset": 354,
          "sentence_ids": [
            11,
            12
          ],
          "fact_types": [
            "aid",
            "response"
          ],
          "importance": "important",
          "evidence_status": "attributed_claim",
          "structured_attributes": [
            {
              "attribute": "response_team",
              "value": "联合国灾害评估与协调小组",
              "unit": null
            },
            {
              "attribute": "attribution",
              "value": "OCHA",
              "unit": null
            }
          ],
          "annotation_note": null
        },
        {
          "fact_span_id": "A003_F008",
          "span_text": "联合国人道主义工作者表示，当前迫切需求包括医疗物资、医疗设施修复、流动医疗队、配备重型清理设备的搜救队伍及安全饮用水。",
          "start_offset": 354,
