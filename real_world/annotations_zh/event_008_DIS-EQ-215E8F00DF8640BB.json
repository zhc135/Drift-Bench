          "span_text": "据地方当局称，地震造成广泛损坏，包括医院、住宅和公共建筑、道路、蓄水设施及燃气管道。\n\n埃法特岛附近村庄也出现山体滑坡，许多地区的通信被切断。\n\n",
          "start_offset": 119,
          "end_offset": 192,
          "sentence_ids": [
            5,
            6,
            7
          ],
          "fact_types": [
            "damage",
            "infrastructure",
            "secondary_hazard"
          ],
          "importance": "important",
          "evidence_status": "attributed_claim",
          "structured_attributes": [
            {
              "attribute": "damage",
              "value": [
                "医院",
                "住宅和公共建筑",
                "道路",
                "蓄水设施",
                "燃气管道"
              ],
              "unit": null
            },
            {
              "attribute": "landslides",
              "value": "埃法特岛附近村庄",
              "unit": null
            },
