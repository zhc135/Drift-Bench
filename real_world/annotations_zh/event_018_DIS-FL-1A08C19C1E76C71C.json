          ],
          "annotation_note": null
        },
        {
          "fact_span_id": "A002_F008",
          "span_text": "合艾的洪水现已消退，但所需的恢复和清理工作规模巨大。数万所住宅受损。街道上散布着碎片，包括破损且沾满泥浆的家具、木条和垃圾。许多居民失去了几乎所有财物。现在，仅仅听到雨声就足以引发恐慌。\n\n",
          "start_offset": 1261,
          "end_offset": 1356,
          "sentence_ids": [
