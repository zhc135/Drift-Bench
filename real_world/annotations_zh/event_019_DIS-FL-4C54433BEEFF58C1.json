      "article_rank": 2,
      "title": "中国西南四川强降雨致46万多人受灾",
      "publisher": "xinhuanet-english",
      "identified_publisher": "Xinhua",
      "source_domain": "english.news.cn",
      "url": "https://english.news.cn/20230704/e1ba965b2cb8406cbdd6192bdf8c4a98/c.html",
