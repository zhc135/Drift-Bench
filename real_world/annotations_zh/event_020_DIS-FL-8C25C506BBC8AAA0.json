      "source_domain": "devdiscourse.com",
      "url": "https://www.devdiscourse.com/article/international/3972476-nepal-floods-could-cost-insurers-over-130-mln-even-before-death-injury-claims",
      "published_at": "2026-09-04T07:29:00+00:00",
      "updated_at": null,
      "language": "zh",
      "original_language": "en",
