              },
              "unit": "people"
            },
            {
              "attribute": "mobile_generators",
              "value": {
                "value": 3000,
                "qualifier": "greater_than"
              },
              "unit": "units"
            },
            {
              "attribute": "pumps",
              "value": 27,
