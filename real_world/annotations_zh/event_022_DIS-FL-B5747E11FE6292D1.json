          ],
          "annotation_note": null
        },
        {
          "fact_span_id": "A003_F010",
          "span_text": "预计台风“桦加沙”还将影响海南省，省会海口将于星期二晚些时候或星期三起暂停上课、渡轮服务、公园运营、工作和营业活动。星期三所有进出海南岛的列车服务都将取消。\n\n中国实行四级应急响应系统，一级为最高级别。 ",
          "start_offset": 1229,
