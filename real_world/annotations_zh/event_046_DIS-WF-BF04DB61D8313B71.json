          ],
          "annotation_note": null
        },
        {
          "fact_span_id": "A002_F011",
          "span_text": "国际援助。 ",
          "start_offset": 1354,
          "end_offset": 1360,
          "sentence_ids": [
            35
          ],
          "fact_types": [
            "non_factual_boilerplate"
          ],
          "importance": "not_applicable",
          "evidence_status": "non_factual_source_text",
          "structured_attributes": [],
          "annotation_note": null
        },
        {
          "fact_span_id": "A002_F012",
          "span_text": "欧盟在欧洲民事保护机制框架内调动援助。在法国，欧盟部署来自捷克、克罗地亚、德国、葡萄牙、斯洛伐克、瑞典和土耳其的7架飞机及4架直升机。其中多数属于 rescEU 消防机队。 ",
          "start_offset": 1360,
          "end_offset": 1447,
          "sentence_ids": [
            36,
            37,
            38
          ],
          "fact_types": [
            "response",
