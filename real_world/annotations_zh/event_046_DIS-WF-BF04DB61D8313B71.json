              "attribute": "landes_area_burned",
              "value": 3500,
              "unit": "ha"
            }
          ],
          "annotation_note": null
        },
        {
          "fact_span_id": "A002_F009",
          "span_text": "被迫离开家园的人数前所未有，这也是法国为森林火灾组织的最大规模人员撤离行动之一。仅吉伦特省的撤离人数就达到220,000人。波尔多周边的整个市镇（例如马尔什普里姆、塞斯塔斯、勒巴尔普、比加诺斯）及卡普费雷已被疏散，或已收到紧急预疏散通知。此外，朗德省还有40,000名流离失所者。\n\n",
          "start_offset": 1035,
          "end_offset": 1177,
          "sentence_ids": [
            28,
            29,
            30,
            31
          ],
          "fact_types": [
            "evacuation",
            "location"
          ],
          "importance": "critical",
          "evidence_status": "explicitly_reported",
          "structured_attributes": [
            {
              "attribute": "gironde_evacuated",
              "value": 220000,
              "unit": "people"
            },
            {
              "attribute": "landes_displaced",
              "value": 40000,
              "unit": "people"
            }
          ],
          "annotation_note": null
        },
        {
          "fact_span_id": "A002_F010",
          "span_text": "得益于民事安全部门及时采取预防性疏散计划，没有平民死亡。不幸的是，救援人员方面损失惨重，共有75名消防员受伤（其中吉伦特主要火线42人、朗德省5人），约10名消防员因较严重烧伤或严重烟雾中毒住院。\n\n吉伦特省政府证实，极其不可预测的火灾突破防御线，吞没并完全摧毁莱日-卡普费雷与马尔什普里姆之间受灾最严重区域的240所住宅（以及私人汽车和农业仓库）。\n\n",
          "start_offset": 1177,
          "end_offset": 1354,
          "sentence_ids": [
            32,
            33,
            34
          ],
          "fact_types": [
            "casualties",
